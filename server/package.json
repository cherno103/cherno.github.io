{
  "name": "minecraft-donate-server",
  "version": "2.0.0",
  "description": "Secure Minecraft donation shop backend with enhanced security",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "init-db": "node database-init.js",
    "cleanup-sessions": "node cleanup-sessions.js",
    "backup": "node backup-database.js create",
    "backup-list": "node backup-database.js list",
    "backup-restore": "node backup-database.js restore",
    "audit": "node security-audit.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
    "express-slow-down": "^1.5.0",
    "express-validator": "^7.0.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "csurf": "^1.11.0",
    "winston": "^3.10.0",
    "node-cache": "^5.1.2",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "compression": "^1.7.4",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.9.0",
    "prettier": "^3.0.0",
    "@types/jest": "^29.0.0",
    "sqlite3-backup": "^1.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}